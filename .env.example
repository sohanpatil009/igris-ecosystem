# .env.example — IGRIS ecosystem (copy to .env, never commit values)
# User creates all keys. Test mode first.

# Optional online voice stack (offline by default)
IGRIS_ONLINE_MODE=false
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# Desktop payments — Paddle sandbox until replica-deploy
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_PRO_PRODUCT_ID=
PADDLE_FAMILY_PRODUCT_ID=

# Android — Play Billing test (licensed testers), no secret here
PLAY_BILLING_TEST=true

# Local ports (defaults match code; change only for debugging)
IGRIS_ECO_PORT=53327
IGRIS_ECO_TLS_PORT=53328
IGRIS_FASTSWAP_PORT=53317
IGRIS_FASTSWAP_TLS_PORT=53318
